# ጂሜይል ለመጠቀም የመተግበሪያ የይለፍ ቃል ያስፈልጋል። ሪፖርቱ ወደ lib/model.js ውስጥ ያሉት REPORT_EMAILS ይላካል።
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Supabase → Project Settings → API. Use the service role key only on the server.
# Run supabase/schema.sql once in the SQL editor, then add the same two values in Vercel.
# Accounts live on the server (data/auth.json locally, app_auth in Supabase). Do not put a password here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
